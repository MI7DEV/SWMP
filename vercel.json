{
  "functions": {
    "api/**/*.js": {
      "memory": 128,
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/nexus/installed", "destination": "/api/nexus-installed" },
    { "source": "/client", "destination": "/client.html" },
    { "source": "/host", "destination": "/host.html" }
  ],
  "headers": [
    { "source": "/mods-catalog.json", "headers": [{ "key": "Cache-Control", "value": "private, max-age=300" }] },
    { "source": "/mods/(.*\\.zip)", "headers": [{ "key": "Cache-Control", "value": "private, max-age=86400" }] }
  ]
}
