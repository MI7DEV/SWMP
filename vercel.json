{
  "version": 2,
  "functions": {
    "api/**/*.js": { "memory": 128, "maxDuration": 10 }
  },
  "routes": [
    { "src": "/api/nexus/browse",    "dest": "/api/nexus.js"           },
    { "src": "/api/nexus/installed", "dest": "/api/nexus-installed.js" },
    { "src": "/api/nexus",           "dest": "/api/nexus.js"           },
    { "src": "/api/config",          "dest": "/api/config.js"          },
    { "src": "/api/info",            "dest": "/api/info.js"            },
    { "src": "/api/health",          "dest": "/api/health.js"          },
    { "src": "/api/nexus-cdn",       "dest": "/api/nexus-cdn.js"       },
    { "src": "/api/megagames-mods",  "dest": "/api/megagames-mods.js"  },
    { "src": "/client",              "dest": "/client.html"            },
    { "src": "/host",                "dest": "/host.html"              },
    { "src": "/(.*)",                "dest": "/$1"                     }
  ]
}
