{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "memory": 128,
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/api/nexus/installed",
      "dest": "/api/nexus-installed.js"
    },
    {
      "src": "/api/config",
      "dest": "/api/config.js"
    },
    {
      "src": "/api/info",
      "dest": "/api/info.js"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/client",
      "dest": "/client.html"
    },
    {
      "src": "/host",
      "dest": "/host.html"
    },
    {
      "src": "/mods-catalog.json",
      "headers": {
        "Cache-Control": "public, max-age=300"
      },
      "dest": "/mods-catalog.json"
    },
    {
      "src": "/mods/(.*\\.zip)",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "dest": "/mods/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
